# ---------------------------------------------------------------------------
# Supabase (Projekt-Einstellungen -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur serverseitig / für Cron-Sync-Scripte (umgeht RLS – NIEMALS im Client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Externe Daten-APIs für die Automatisierung
# ---------------------------------------------------------------------------
HUGGINGFACE_TOKEN=hf_xxx
OPENROUTER_API_KEY=sk-or-xxx

# Schützt die /api/cron/* Endpunkte (Vercel Cron sendet diesen als Bearer)
CRON_SECRET=change-me
